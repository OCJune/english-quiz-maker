{
  "name": "ariaforge",
  "version": "0.1.0",
  "private": true,
  "description": "자동 영어 문제 제작 프로그램",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "selftest": "node scripts/build.mjs && electron out/main/index.js --self-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "adm-zip": "^0.6.1",
    "docx": "^9.7.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "productName": "AriaForge",
  "author": {
    "name": "OCJune"
  }
}
